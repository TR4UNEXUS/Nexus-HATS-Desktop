<Application x:Class="Hats.WinUI.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>
      <Color x:Key="SystemAccentColor">#6479D9</Color>
      <Color x:Key="SystemAccentColorLight1">#A2ABFF</Color>
      <Color x:Key="SystemAccentColorLight2">#B6C8FF</Color>
